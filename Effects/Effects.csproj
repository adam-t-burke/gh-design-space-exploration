<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DseGrasshopperPlugin>true</DseGrasshopperPlugin>
    <TargetFrameworks>net48;net7.0</TargetFrameworks>
    <RootNamespace>MyProject1</RootNamespace>
    <AssemblyName>MyProject1</AssemblyName>
    <!-- Post-build used to rename MyProject1.dll to Effects.gha. Keep that file name. -->
    <TargetName>Effects</TargetName>
    <DseLegacyOutputDir>$(MSBuildThisFileDirectory)..\Output\Simplify\Effects\</DseLegacyOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DSECommon\DSECommon.csproj" />
  </ItemGroup>
</Project>
