    <RootNamespace>DSE.Optimization.UI</RootNamespace>
    <AssemblyName>DSE.Optimization.UI</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Eto comes from the RhinoCommon package. Compile-only; Rhino supplies it at runtime. -->
