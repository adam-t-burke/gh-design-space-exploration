<Project>
  <PropertyGroup Condition="'$(DseGrasshopperPlugin)' == 'true'">
    <DseRhinoReferences>true</DseRhinoReferences>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!--
    WPF markup compilation looks for AssemblyName.dll. TargetExt=.gha hides that
    file and the XAML build fails, so WPF projects keep a .dll and copy a .gha beside it.
  -->
  <PropertyGroup Condition="'$(DseGrasshopperPlugin)' == 'true' and '$(DseWpfPlugin)' != 'true'">
    <TargetExt>.gha</TargetExt>
  </PropertyGroup>

  <!--
    AllProjects.sln maps Debug to Debug64 for several projects. SDK defaults only
    treat Configuration=Debug as a debug build, and the WPF markup compiler looks
    under obj\$(Configuration)\$(TargetFramework). Keep those paths aligned.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug64' or '$(Configuration)' == 'Debug32'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DseWpfPlugin)' == 'true'">
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(DseRhinoReferences)' == 'true'">
    <PackageReference Include="RhinoCommon" Version="$(DseRhinoVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Grasshopper" Version="$(DseRhinoVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(DseRhinoReferences)' == 'true' and '$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(DseRhinoReferences)' == 'true' and '$(TargetFramework)' == 'net7.0'">
    <PackageReference Include="System.Drawing.Common" Version="7.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    SDK-style projects reject bitmap .resx entries unless resources are preserialized.
    Grasshopper plugins embed icon bitmaps, so this applies to every target framework
    of those projects, including net48. Projects without a bitmap resx do not set
    DseGrasshopperPlugin solely for this; libraries are left alone.
  -->
  <PropertyGroup Condition="'$(DseGrasshopperPlugin)' == 'true'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup Condition="'$(DseGrasshopperPlugin)' == 'true'">
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <!-- WPF UI packages kept at the versions the net48 projects already used. -->
  <ItemGroup Condition="'$(DseWpfPlugin)' == 'true'">
    <PackageReference Include="LiveCharts" Version="0.9.7" />
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="MaterialDesignColors" Version="1.1.3" />
    <PackageReference Include="MaterialDesignThemes" Version="2.4.0.1044" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="NLoptNet" Version="1.4.3" />
  </ItemGroup>

  <Target Name="CopyWpfPluginGha" AfterTargets="Build" Condition="'$(DseWpfPlugin)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).gha" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Keep the net48 build in the flat bin\$(Configuration) folder and in the historical
    Output\ tree so the existing Windows Yak script still finds .gha files and companion DLLs.
    net7.0 stays under bin\$(Configuration)\net7.0 and is not copied over the net48 output.
  -->
  <Target Name="StageNet48FlatBin" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net48' and '$(AppendTargetFrameworkToOutputPath)' == 'true'">
    <PropertyGroup>
      <_DseFlatBin>$(MSBuildProjectDirectory)\bin\$(Configuration)\</_DseFlatBin>
    </PropertyGroup>
    <ItemGroup>
      <_DseFlatFiles Include="$(TargetDir)*.gha" />
      <_DseFlatFiles Include="$(TargetDir)*.dll" />
      <_DseFlatFiles Include="$(TargetDir)*.exe" />
      <_DseFlatFiles Include="$(TargetDir)*.config" />
    </ItemGroup>
    <Copy SourceFiles="@(_DseFlatFiles)" DestinationFolder="$(_DseFlatBin)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLegacyOutput" AfterTargets="StageNet48FlatBin" Condition="'$(DseLegacyOutputDir)' != '' and '$(TargetFramework)' == 'net48'">
    <ItemGroup>
      <_DseLegacyFiles Include="$(TargetDir)*.gha" />
      <_DseLegacyFiles Include="$(TargetDir)*.dll" />
      <_DseLegacyFiles Include="$(TargetDir)*.exe" />
      <_DseLegacyFiles Include="$(TargetDir)*.config" />
    </ItemGroup>
    <MakeDir Directories="$(DseLegacyOutputDir)" />
    <Copy SourceFiles="@(_DseLegacyFiles)" DestinationFolder="$(DseLegacyOutputDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
