<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DseGrasshopperPlugin>true</DseGrasshopperPlugin>
    <TargetFrameworks>net48;net7.0</TargetFrameworks>
    <RootNamespace>Stepper</RootNamespace>
    <AssemblyName>Stepper</AssemblyName>
    <DseLegacyOutputDir>$(MSBuildThisFileDirectory)..\Output\Optimize\Stepper\</DseLegacyOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="Stepper\StepperComponent.cs" />
    <Compile Include="Stepper\StepperComponentAttributes.cs" />
    <Compile Include="Stepper\StepperInfo.cs" />
    <Compile Include="StepperHost.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\Resources.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DSE.Optimization.Core\DSE.Optimization.Core.csproj" />
    <ProjectReference Include="..\DSE.Optimization.UI\DSE.Optimization.UI.csproj" />
  </ItemGroup>
  <Import Project="..\DSE.Optimization.Core\StageOptimizationAssets.targets" />
</Project>
