<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DseGrasshopperPlugin>true</DseGrasshopperPlugin>
    <TargetFrameworks>net48;net7.0</TargetFrameworks>
    <RootNamespace>MOO</RootNamespace>
    <AssemblyName>MOO</AssemblyName>
    <DseLegacyOutputDir>$(MSBuildThisFileDirectory)..\Output\Optimize\MOO\</DseLegacyOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.0.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DSECommon\DSECommon.csproj" />
    <ProjectReference Include="..\JMetalCSharp.V05\JMetalCSharp\JMetalCSharp.csproj" />
  </ItemGroup>
</Project>
